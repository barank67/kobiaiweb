---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { allPressItems, fallbackPressImage } from "../../data/press";

export function getStaticPaths() {
  return allPressItems.flatMap((post) => {
    const canonicalPath = `/basinda-biz/${post.slug}/`;
    const paths = [{ params: { slug: post.slug }, props: { post, canonicalPath } }];

    try {
      const decodedSlug = decodeURIComponent(post.slug);
      if (decodedSlug !== post.slug) {
        paths.push({ params: { slug: decodedSlug }, props: { post, canonicalPath } });
      }
    } catch {
      // Keep the original slug only when legacy data contains malformed escape sequences.
    }

    return paths;
  });
}

const { post, canonicalPath } = Astro.props;
const image = post.image || fallbackPressImage;
const isDirectVideo = post.videoUrl && /\.(mp4|webm|ogg)(?:$|\?)/i.test(post.videoUrl);
const canonicalUrl = new URL(canonicalPath, Astro.site ?? Astro.url.origin).toString();
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: post.title,
  description: post.seoDescription || post.excerpt,
  image: new URL(image, Astro.site ?? Astro.url.origin).toString(),
  datePublished: post.date,
  dateModified: post.date,
  publisher: { "@type": "Organization", name: "Kobi AI" },
  mainEntityOfPage: canonicalUrl
};
---
<BaseLayout
  title={`${post.seoTitle || post.title} - Kobi ai`}
  description={post.seoDescription || post.excerpt}
  image={image}
  type="article"
  publishedTime={post.date}
  canonical={canonicalUrl}
>
  <section class="page-hero light-page-hero blog-detail-hero">
    <div class="reveal-box">
      <p>{post.date}</p>
      <h1>{post.title}</h1>
    </div>
  </section>
  <article class="article blog-article">
    <figure>
      <img src={image} alt={post.title} loading="eager" />
    </figure>
    <p class="article-lead">{post.excerpt}</p>
    {post.contentHtml ? (
      <div class="article-html" set:html={post.contentHtml} />
    ) : (
      post.content.split(/\n+/).filter(Boolean).map((paragraph) => <p>{paragraph}</p>)
    )}
    {post.embedUrl && (
      <div class="media-embed">
        <iframe
          src={post.embedUrl}
          title={post.title}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        />
      </div>
    )}
    {post.audioUrl && (
      <audio class="article-audio" controls src={post.audioUrl}>
        Tarayıcınız ses oynatmayı desteklemiyor.
      </audio>
    )}
    {isDirectVideo && (
      <video class="article-video" controls src={post.videoUrl} poster={image}>
        Tarayıcınız video oynatmayı desteklemiyor.
      </video>
    )}
    {post.videoUrl && !post.embedUrl && !isDirectVideo && (
      <p class="source-link">
        <a href={post.videoUrl} target="_blank" rel="noopener noreferrer">Yayını izle</a>
      </p>
    )}
    {post.sourceUrl && (
      <p class="source-link">
        <a href={post.sourceUrl} target="_blank" rel="noopener noreferrer">Haberi kaynağında oku</a>
      </p>
    )}
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
