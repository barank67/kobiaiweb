---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { allRadioTvPosts, fallbackPressImage, pressPerPage } from "../../../../data/press";

export function getStaticPaths() {
  const totalPages = Math.ceil(allRadioTvPosts.length / pressPerPage);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const page = index + 2;
    return { params: { page: String(page) }, props: { page } };
  });
}

const { page } = Astro.props;
const totalPages = Math.ceil(allRadioTvPosts.length / pressPerPage);
const pagePosts = allRadioTvPosts.slice((page - 1) * pressPerPage, page * pressPerPage);
---
<BaseLayout
  title={`Radyo Televizyon Sayfa ${page} - Basında Biz - Kobi ai`}
  description="Kobi AI hakkında radyo, televizyon, canlı yayın ve ses kayıtları."
>
  <section class="page-hero light-page-hero">
    <div class="reveal-box">
      <p>Basında Biz</p>
      <h1>Kobi AI radyo televizyon kayıtları</h1>
    </div>
  </section>
  <section class="section blog-listing">
    <div class="blog-grid">
      {pagePosts.map((post) => (
        <a class="blog-card lift-card" href={`/basinda-biz/${post.slug}/`}>
          <figure>
            <img
              src={post.image || fallbackPressImage}
              alt={post.title}
              width="640"
              height="400"
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div>
            <h2>{post.title}</h2>
            <p>{post.excerpt}</p>
          </div>
        </a>
      ))}
    </div>
    <nav class="pagination" aria-label="Radyo Televizyon sayfaları">
      <a href="/basinda-biz/radyo-televizyon/">1</a>
      {Array.from({ length: totalPages - 1 }, (_, index) => {
        const pageNumber = index + 2;
        return pageNumber === page
          ? <span class="is-current">{pageNumber}</span>
          : <a href={`/basinda-biz/radyo-televizyon/page/${pageNumber}/`}>{pageNumber}</a>;
      })}
    </nav>
  </section>
</BaseLayout>
